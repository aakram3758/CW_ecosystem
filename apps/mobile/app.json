{
  "expo": {
    "name": "Clouds Water",
    "slug": "clouds-water",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "cloudswater",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "locales": {
      "en": "./locales/en.json"
    },
    "android": {
      "package": "co.cloudswater.app",
      "predictiveBackGestureEnabled": false,
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B2340"
      }
    },
    "ios": {
      "bundleIdentifier": "co.cloudswater.app",
      "supportsTablet": false,
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/cw-logo.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "backgroundColor": "#0B2340",
          "dark": {
            "image": "./assets/cw-logo.png",
            "backgroundColor": "#071322"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "يستخدم التطبيق الكاميرا لتصوير الميزان: مع طلب الاستلام من الفرع، ولتوثيق الزيارة من السائق.",
          "photosPermission": "يحتاج التطبيق للوصول إلى صورك لإرفاق صورة الميزان بطلب الاستلام.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "يستخدم التطبيق موقعك مرة واحدة لتحديد موقع الفرع على الخريطة.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "6522f029-5afe-46db-aa53-05c3ddf4ebf2"
      }
    },
    "owner": "ahmedakram12"
  }
}
