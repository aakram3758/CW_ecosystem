{
  "expo": {
    "name": "Clouds Water",
    "slug": "clouds-water",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "cloudswater",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "co.cloudswater.app",
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "bundleIdentifier": "co.cloudswater.app",
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B2340",
          "dark": {
            "backgroundColor": "#071322"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "يستخدم التطبيق الكاميرا لتصوير المادة على الميزان مع طلب الاستلام.",
          "photosPermission": "يحتاج التطبيق للوصول إلى صورك لإرفاق صورة الميزان بطلب الاستلام.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "يستخدم التطبيق موقعك مرة واحدة لتحديد موقع الفرع على الخريطة.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
